Description: Fix TLS unit test failures and test cert generation.
 Add extendedKeyUsage to generated test certificates. Upstream now provides
 subjectAltName and passes -cafile during channel import, so only the EKU
 additions remain needed for Debian's stricter certificate validation.
Author: Lena Voytek <lena@debian.org>
Forwarded: not-needed
Last-Update: 2026-10-28
--- a/utils/gen-test-certs.sh
+++ b/utils/gen-test-certs.sh
@@ -46,11 +46,13 @@
 [ server_cert ]
 keyUsage = digitalSignature, keyEncipherment
 nsCertType = server
+extendedKeyUsage = serverAuth
 subjectAltName = IP:127.0.0.1, IP:::1, DNS:localhost
 
 [ client_cert ]
 keyUsage = digitalSignature, keyEncipherment
 nsCertType = client
+extendedKeyUsage = clientAuth
 subjectAltName = URI:urn:valkey:user:first, URI:urn:valkey:user:second
 
 [ generic_cert ]
