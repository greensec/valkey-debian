#!/usr/bin/make -f

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk
include /usr/share/dpkg/architecture.mk

export BUILD_TLS = yes
export CFLAGS CPPFLAGS LDFLAGS
export DEB_BUILD_MAINT_OPTIONS = hardening=+all optimize=+lto
export DEB_CFLAGS_MAINT_APPEND = -I/usr/include/liblzf
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-no-as-needed -ldl -latomic -llzf

# Build jemelloc in parallel
ifneq (,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	NUMJOBS = $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
	MAKEFLAGS += -j$(NUMJOBS)
	export MAKEFLAGS
endif

%:
	dh $@

override_dh_auto_clean:
	dh_auto_clean
	rm -f src/release.h debian/*.service

override_dh_auto_build:
ifeq (linux,$(DEB_HOST_ARCH_OS))
	dh_auto_build -- V=1 USE_SYSTEM_JEMALLOC=yes USE_SYSTEMD=yes USE_JEMALLOC=yes
else
	dh_auto_build -- V=1 USE_SYSTEM_JEMALLOC=no USE_SYSTEMD=yes USE_JEMALLOC=yes
endif

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	# Generate a root CA and server certificate for testing
	./utils/gen-test-certs.sh
	# Run the upstream test suites. Capture the overall result so that
	# test failures cause the build to fail while still cleaning up.
	TEST_FAIL=0
	# Avoid race conditions in upstream testsuite
	./runtest --clients 1 --verbose --dump-logs --tls || TEST_FAIL=1
	timeout 30m ./runtest-cluster --tls || TEST_FAIL=1
	./runtest-sentinel || TEST_FAIL=1
	# Clean up after gen-test-certs.sh
	rm -rf tests/tls || :
	# Other cleanup
	find tests/tmp ! -name .gitignore -type f -exec rm -rfv {} + || :
	[ "$$TEST_FAIL" -eq 0 ]
endif

override_dh_auto_install:
	debian/bin/generate-systemd-service-files

# dh_installsysusers is not in the default compat-13 sequence, but the
# command is available in all supported releases. Call it explicitly before
# dh_installtmpfiles so the valkey user/group exists before the tmpfiles
# snippets are generated.
override_dh_installtmpfiles:
	dh_installsysusers
	dh_installtmpfiles

override_dh_compress:
	dh_compress -Xredis-trib.rb

override_dh_installchangelogs:
	dh_installchangelogs --keep 00-RELEASENOTES
